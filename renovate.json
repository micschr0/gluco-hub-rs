{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits"],
  "labels": ["dependencies"],
  "baseBranchPatterns": ["staging"],
  "automerge": false,

  "timezone": "Europe/Berlin",

  "cargo": {
    "rangeStrategy": "update-lockfile"
  },

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "schedule": ["at any time"],
    "automerge": false
  },

  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["after 8am and before 6pm on Sunday"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/", "/^Taskfile\\.yml$/", "/^CLAUDE\\.md$/", "/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["cargo install (?<depName>cargo-(?:chef|auditable|release)) --version (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) --locked"],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    }
  ],

  "packageRules": [
    {
      "description": "Never pin Cargo crate versions to exact '=' — project convention keeps latest minor ranges in Cargo.toml, pins live only in Cargo.lock. Docker digests and GitHub Actions SHAs are still pinned via config:best-practices.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["pin"],
      "enabled": false
    },
    {
      "description": "Group the tokio ecosystem into a single PR",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["tokio*"],
      "groupName": "tokio ecosystem",
      "automerge": false
    },
    {
      "description": "Group the serde ecosystem into a single PR",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde*"],
      "groupName": "serde ecosystem",
      "automerge": false
    },
    {
      "description": "Group the axum / tower ecosystem into a single PR",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["axum*", "tower*"],
      "groupName": "axum + tower ecosystem",
      "automerge": false
    },
    {
      "description": "Group the tracing ecosystem into a single PR",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["tracing*"],
      "groupName": "tracing ecosystem",
      "automerge": false
    },
    {
      "description": "Hold non-major Cargo updates for 7d before the staging review gate",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Group GitHub Actions bumps for the staging review gate. SHA pinning is enforced by helpers:pinGitHubActionDigestsToSemver (via config:best-practices).",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Major Cargo updates require manual review",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
